# Example .env file for the QSTrader examples.
#
# Copy this file to '.env' and edit it to suit your setup:
#
#     cp .env.example .env
#
# The scripts in examples/ read this file themselves, so no extra packages
# are needed. Variables already set in your shell always take precedence
# over the values here, and '.env' itself is git-ignored.
#
# The file is looked up in this order, and the first one found is used:
#
#   1. The path given by QSTRADER_ENV_FILE, if set.
#   2. '.env' in the current directory.
#   3. '.env' in the repository root.
#
# Blank lines and '#' comments are ignored, an 'export ' prefix is allowed,
# and quoted values are supported. Relative paths are resolved against the
# directory the script is run from. Directories are created if missing.

# Where the downloaded <SYMBOL>.csv price data is written to by
# examples/download_data.py, and read from by the example backtests.
# Defaults to the current directory when unset.
QSTRADER_CSV_DATA_DIR=data

# Where the examples save their tearsheet PNGs.
# Defaults to 'out' at the repository root when unset.
QSTRADER_OUTPUT_DIR=out
